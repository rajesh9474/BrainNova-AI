# BrainNova.AI - Server Environment Configuration

PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/brainnova
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/brainnova?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/brainnova

# JWT Secret for signing user authentication tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth Client Credentials (from Google Cloud Console -> APIs & Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Groq API Key for AI study tools (summaries, quizzes, flashcards, Q&A)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
